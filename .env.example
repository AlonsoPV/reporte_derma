# PostgreSQL connection string (Replit Database or external)
DATABASE_URL="postgresql://user:password@localhost:5432/reporte_derma?schema=public&options=-c%20TimeZone%3DAmerica%2FMexico_City"

# Session secret — required outside development (>= 32 chars)
SESSION_SECRET="dev-only-change-me-to-a-long-random-secret"

# Public app origin(s) for CORS / CSRF checks in production (comma-separated)
# APP_ORIGIN="https://your-app.example"

# Optional dedicated password for dermaops_app DB role
# RLS_DB_PASSWORD=""

# Environment
NODE_ENV="development"
PORT=5000
# Local tip: if port 5000 is taken, use 5050 and point Vite proxy to it

# Timezone for the clinic
TZ="America/Mexico_City"

# Never set in real production clinics unless intentionally reseeding demo data
# ALLOW_DEMO_SEED="true"
