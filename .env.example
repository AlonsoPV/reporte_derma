# PostgreSQL connection string (Replit Database or external)
DATABASE_URL="postgresql://user:password@localhost:5432/reporte_derma?schema=public"

# Session secret — use a long random string in production
SESSION_SECRET="change-me-to-a-long-random-secret"

# Environment
NODE_ENV="development"
PORT=5000
# Local tip: if port 5000 is taken, use 5050 and point Vite proxy to it

# Timezone for the clinic
TZ="America/Mexico_City"
