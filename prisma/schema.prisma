generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  RECEPTION
  SUPERVISOR
  ACCOUNTING
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum OperationalStatus {
  PENDING
  ATTENDED
  NO_SHOW
  CANCELLED
  RESCHEDULED
}

enum AttendanceOrigin {
  SCHEDULED
  WALK_IN
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum ClosureStatus {
  OPEN
  CLOSED
}

enum DataSource {
  DEMO
  IMPORT
  MANUAL
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role
  status       UserStatus @default(ACTIVE)
  doctorId     String?    @unique
  doctor       Doctor?    @relation(fields: [doctorId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  createdAttendances Attendance[]    @relation("AttendanceCreatedBy")
  closedDays         DailyClosure[]  @relation("ClosureClosedBy")
  reopenedDays       DailyClosure[]  @relation("ClosureReopenedBy")
  imports            ImportBatch[]
  auditLogs          AuditLog[]

  @@map("users")
}

model Doctor {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?
  appointments Appointment[]
  attendances  Attendance[]
  closures     DailyClosure[]
  nameMappings DoctorNameMapping[]

  @@map("doctors")
}

model DoctorNameMapping {
  id            String   @id @default(cuid())
  excelName     String   @unique
  doctorId      String
  doctor        Doctor   @relation(fields: [doctorId], references: [id])
  createdAt     DateTime @default(now())

  @@map("doctor_name_mappings")
}

model Appointment {
  id                      String            @id @default(cuid())
  externalAppointmentId   String            @unique
  appointmentDate         DateTime          @db.Date
  startTime               String
  endTime                 String?
  duration                String?
  patientName             String
  phone                   String?
  insurance               String?
  birthDate               DateTime?         @db.Date
  email                   String?
  sourceStatus            String?
  attendanceConfirmation  String?
  tags                    String?
  notes                   String?
  calendar                String?
  sourceDoctorName        String?
  doctorId                String?
  doctor                  Doctor?           @relation(fields: [doctorId], references: [id])
  operationalStatus       OperationalStatus @default(PENDING)
  noShowReason            String?
  noShowNotes             String?
  importId                String?
  importBatch             ImportBatch?      @relation(fields: [importId], references: [id])
  dataSource              DataSource        @default(IMPORT)
  isDemo                  Boolean           @default(false)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  attendance Attendance?

  @@index([appointmentDate, doctorId])
  @@index([operationalStatus])
  @@index([patientName])
  @@map("appointments")
}

model Attendance {
  id             String           @id @default(cuid())
  appointmentId  String?          @unique
  appointment    Appointment?     @relation(fields: [appointmentId], references: [id])
  doctorId       String
  doctor         Doctor           @relation(fields: [doctorId], references: [id])
  patientName    String
  phone          String?
  email          String?
  birthDate      DateTime?        @db.Date
  scheduledTime  String?
  actualTime     String
  treatment      String
  amount         Decimal          @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  notes          String?
  origin         AttendanceOrigin
  dataSource     DataSource       @default(MANUAL)
  isDemo         Boolean          @default(false)
  attendanceDate DateTime         @db.Date
  createdById    String
  createdBy      User             @relation("AttendanceCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([attendanceDate, doctorId])
  @@index([treatment])
  @@map("attendances")
}

model DailyClosure {
  id                 String        @id @default(cuid())
  doctorId           String
  doctor             Doctor        @relation(fields: [doctorId], references: [id])
  date               DateTime      @db.Date
  scheduledCount     Int           @default(0)
  attendedCount      Int           @default(0)
  walkInCount        Int           @default(0)
  noShowCount        Int           @default(0)
  cancelledCount     Int           @default(0)
  rescheduledCount   Int           @default(0)
  totalAmount        Decimal       @db.Decimal(12, 2) @default(0)
  cashAmount         Decimal       @db.Decimal(12, 2) @default(0)
  cardAmount         Decimal       @db.Decimal(12, 2) @default(0)
  transferAmount     Decimal       @db.Decimal(12, 2) @default(0)
  otherAmount        Decimal       @db.Decimal(12, 2) @default(0)
  treatmentsSnapshot Json?
  status             ClosureStatus @default(CLOSED)
  closedById         String
  closedBy           User          @relation("ClosureClosedBy", fields: [closedById], references: [id])
  closedAt           DateTime      @default(now())
  reopenedById       String?
  reopenedBy         User?         @relation("ClosureReopenedBy", fields: [reopenedById], references: [id])
  reopenedAt         DateTime?
  reopenReason       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([doctorId, date])
  @@map("daily_closures")
}

model ImportBatch {
  id             String   @id @default(cuid())
  filename       String
  uploadedById   String
  uploadedBy     User     @relation(fields: [uploadedById], references: [id])
  uploadedAt     DateTime @default(now())
  rowsDetected   Int      @default(0)
  createdCount   Int      @default(0)
  updatedCount   Int      @default(0)
  cancelledCount Int      @default(0)
  errorCount     Int      @default(0)
  doctorsDetected Json?
  errors         Json?
  previewData    Json?
  confirmed      Boolean  @default(false)

  appointments Appointment[]

  @@map("imports")
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  action       String
  entityType   String
  entityId     String?
  previousValue Json?
  newValue     Json?
  timestamp    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("audit_logs")
}

model Session {
  sid    String   @id
  sess   Json
  expire DateTime

  @@index([expire])
  @@map("session")
}
